# Database Configuration
DATABASE_URL=sqlite:///./data/scraping.db

# Scraping Schedule (Singapore Time)
SCRAPE_SCHEDULE_TIME=08:00
TZ=Asia/Singapore

# Application Settings
PORT=8000
HOST=0.0.0.0

# Target Vehicles (comma-separated, optional - uses config.py defaults if not set)
# TARGET_VEHICLES=TOYOTA HIACE,HINO DUTRO,NISSAN NV350

# Scraping Settings (optional)
# HEADLESS=true
# SCRAPE_TIMEOUT=120000
